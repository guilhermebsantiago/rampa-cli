  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "bench": "node run.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@qualweb/act-rules": "0.8.6",
    "@qualweb/best-practices": "0.7.13",
    "@qualweb/core": "0.9.5",
    "@qualweb/wcag-techniques": "0.4.9",
    "@siteimprove/alfa-act": "0.119.0",
    "@siteimprove/alfa-playwright": "0.84.2",
    "@siteimprove/alfa-rules": "0.119.0",
    "accessibility-checker-engine": "4.0.34",
    "axe-core": "4.14.0",
    "lighthouse": "13.5.0",
    "pa11y": "10.0.0",
    "playwright-core": "1.63.0"
  }
}
