{
  "$id": "https://raw.githubusercontent.com/guilhermebsantiago/rampa-cli/main/schema/snapshot.schema.json",
  "title": "Rampa accessibility snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "surface": {
      "type": "string",
      "enum": [
        "web",
        "android",
        "ios",
        "windows",
        "macos",
        "image"
      ]
    },
    "target": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "scale"
      ],
      "additionalProperties": false
    },
    "root": {
      "$ref": "#/$defs/__schema0"
    },
    "screenshot": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "html",
            "android-xml",
            "ios-xml",
            "uia-xml"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false
    },
    "truncated": {
      "type": "boolean"
    },
    "destinations": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "page",
              "file",
              "same-page",
              "unreadable"
            ]
          },
          "status": {
            "type": "number"
          },
          "finalUrl": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "object",
      "properties": {
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "keyboard",
                  "layout",
                  "hover",
                  "orientation",
                  "media",
                  "auth",
                  "clock",
                  "interact",
                  "form"
                ]
              },
              "version": {
                "type": "string"
              },
              "conditions": {
                "type": "object",
                "properties": {
                  "viewport": {
                    "type": "object",
                    "properties": {
                      "width": {
                        "type": "number"
                      },
                      "height": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  "deviceScaleFactor": {
                    "type": "number"
                  },
                  "browser": {
                    "type": "string"
                  },
                  "variant": {
                    "type": "string"
                  },
                  "colorScheme": {
                    "type": "string",
                    "enum": [
                      "light",
                      "dark"
                    ]
                  },
                  "reducedMotion": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "viewport",
                  "deviceScaleFactor",
                  "browser"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "skipped"
                ]
              },
              "reason": {
                "type": "string"
              },
              "guard": {
                "type": "object",
                "properties": {
                  "blocked": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "at": {
                          "type": "number"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "method",
                        "url",
                        "at"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "navigations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "at": {
                          "type": "number"
                        },
                        "cause": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "url",
                        "at"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "dialogs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "at": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "type",
                        "message",
                        "at"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "blocked",
                  "navigations",
                  "dialogs"
                ],
                "additionalProperties": false
              },
              "durationMs": {
                "type": "number"
              },
              "data": {}
            },
            "required": [
              "kind",
              "version",
              "conditions",
              "status",
              "guard",
              "durationMs",
              "data"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "probes"
      ],
      "additionalProperties": false
    },
    "reach": {
      "type": "object",
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "collected": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "engine": {
                "type": "boolean"
              },
              "engineReason": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "collected"
            ],
            "additionalProperties": false
          }
        },
        "shadowRoots": {
          "type": "object",
          "properties": {
            "open": {
              "type": "number"
            },
            "closed": {
              "type": "number"
            },
            "closedHosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "open"
          ],
          "additionalProperties": false
        },
        "unsettledAfterMs": {
          "type": "number"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "siblings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "collectedAt": {
      "type": "string"
    },
    "collector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "surface",
    "target",
    "viewport",
    "root",
    "collectedAt",
    "collector"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounds": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "image": {
          "type": "string"
        },
        "native": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "ref",
        "role",
        "states",
        "native",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
