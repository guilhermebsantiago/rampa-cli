# Kept out of git, as the second study's were: the recordings (snapshots and engine results), screenshots,
# judgment and destination caches, and image crops. data/recordings.json has the size and SHA-256 of every
# recording file, so a copy kept elsewhere can be checked before judgments are re-run on it.
pages/*/recording/
pages/*/probe-recording/
pages/*/*.png
pages/*/cache/
pages/*/cache-*/
pages/*/.rampa/
pages/*/*-collect.json
packets/*/
# Attempts set aside (a connection drop, a rate limit): their logs are kept, not their recordings or caches.
pages/*/discarded-*/**/recording/
pages/*/discarded-*/**/probe-recording/
pages/*/discarded-*/**/*.png
pages/*/discarded-*/**/cache*/
pages/*/discarded-*/**/*-collect.json
# Bytecode from scripts/exploratory.py importing scripts/extras.py.
scripts/__pycache__/
